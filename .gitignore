# Rust
/target/
**/*.rs.bk
*.pdb

# Node (attax / tooling)
node_modules/

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Logs and local artifacts
*.log
/tmp/

# Local match output
/out/
# Machine-wide measurement lock (scripts/measurement-lock.sh)
/.measurement-lock/

# Python
__pycache__/
*.pyc

# Rendered videos (videos/manifest.json is committed; the MP4s are local)
/videos/*.mp4
/videos/*.png
/videos/.render-log.jsonl
/videos/*.zip

# Measurement evidence: keep the summaries, not the raw replays/logs/audits.
# A 40-game run is ~17 MB of JSONL that no reader needs in git.
scripts/evidence/*/replays/
scripts/evidence/*/logs/
scripts/evidence/*/audit/
