# Rust
/target/
**/*.rs.bk
*.pdb

# Node (attax / tooling)
node_modules/

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Logs and local artifacts
*.log
/tmp/

# Local match output
/out/
# Machine-wide measurement lock (scripts/measurement-lock.sh)
/.measurement-lock/

# Measurement evidence: the summaries are the record; replays, logs and audits
# are large and reproducible from the game, so they stay local.
scripts/evidence/*/replays/
scripts/evidence/*/logs/
scripts/evidence/*/audit/

# Python
__pycache__/
*.pyc

# Rendered videos (videos/manifest.json is committed; the MP4s are local)
/videos/*.mp4
/videos/*.png
/videos/.render-log.jsonl
/videos/*.zip
